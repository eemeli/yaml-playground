{
  "name": "yaml-playground",
  "private": true,
  "license": "ISC",
  "author": "Eemeli Aro <eemeli@gmail.com>",
  "repository": "github:eemeli/yaml-playground",
  "description": "YAML playground",
  "keywords": [
    "YAML",
    "playground",
    "AST",
    "JSON"
  ],
  "homepage": "https://github.com/eemeli/yaml-playground#readme",
  "scripts": {
    "build": "rollup ../dist/index.js --plugin terser --sourcemap --file site/yaml.min.js --format umd --name YAML",
    "start": "http-server site"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "http-server": "^14.1.1",
    "rollup": "^4.53.3"
  }
}
